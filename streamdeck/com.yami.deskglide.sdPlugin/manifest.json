{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.yami.deskglide",
  "Name": "DeskGlide",
  "Category": "DeskGlide",
  "CategoryIcon": "imgs/category",
  "Author": "Yami",
  "Description": "Save instant replays, start and stop video recordings, open remote computers and control mouse transitions with live DeskGlide status.",
  "Version": "1.1.0.0",
  "CodePath": "bin/plugin.js",
  "Icon": "imgs/plugin",
  "URL": "https://github.com/Aleksei-Melnik/DeskGlide",
  "SDKVersion": 3,
  "Nodejs": {
    "Version": "24"
  },
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "PropertyInspectorPath": "ui/settings.html",
  "Actions": [
    {
      "UUID": "com.yami.deskglide.save-replay",
      "Name": "Save Replay",
      "Tooltip": "Save Replay",
      "Icon": "imgs/save-replay-list",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/save-replay",
          "TitleAlignment": "bottom",
          "FontSize": 10
        },
        {
          "Image": "imgs/save-replay",
          "TitleAlignment": "bottom",
          "FontSize": 10
        }
      ]
    },
    {
      "UUID": "com.yami.deskglide.recording",
